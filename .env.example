# Public URL of the deployed site
SITE_URL=https://duha.example.com

# Port and interface (defaults are fine)
PORT=3000
HOST=0.0.0.0

# production enables secure cookies behind HTTPS proxies
NODE_ENV=production
TRUST_PROXY=1
COOKIE_SECURE=auto

# Optional: keep the SQLite database somewhere else
# DATA_DIR=./data
